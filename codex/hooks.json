{
  "description": "Sync repositories at session start and protect Git pushes with shared agent hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/hooks/git-session-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing Git repository"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.agents/hooks/git-push-policy.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
