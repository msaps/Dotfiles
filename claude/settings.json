{
  "permissions": {
    "allow": [
      "Bash(npm uninstall:*)",
      "Bash(ls:*)",
      "Bash(volta which:*)",
      "Bash(volta list:*)",
      "Bash(volta run node:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge --auto --squash:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh release list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git branch)",
      "Bash(git branch -m *)",
      "Bash(git branch -d *)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git checkout -b *)",
      "Bash(git tag:*)",
      "Bash(pnpm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(xcodebuildmcp:*)",
      "Bash(xcodebuild:*)",
      "Bash(sed:*)",
      "Bash(swift build:*)",
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *-X POST*)",
      "Bash(curl *-X PUT*)",
      "Bash(curl *-X PATCH*)",
      "Bash(curl *-X DELETE*)",
      "Bash(curl *--request POST*)",
      "Bash(curl *--request PUT*)",
      "Bash(curl *--request PATCH*)",
      "Bash(curl *--request DELETE*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo delete:*)"
    ],
    "ask": [
      "Bash(git push --force-with-lease*)",
      "Bash(curl *--data *)",
      "Bash(curl *-d *)",
      "Bash(curl *--upload-file *)",
      "Bash(curl *-T *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/safe-force-push-check.sh",
            "if": "Bash(git push*)",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}