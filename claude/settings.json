{
  "permissions": {
    "allow": [
      "Bash(npm uninstall:*)",
      "Bash(ls:*)",
      "Bash(volta which:*)",
      "Bash(volta list:*)",
      "Bash(volta run node:*)",
      "Bash(gh pr:*)",
      "Bash(gh release list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git -c:*)",
      "Bash(git tag:*)",
      "Bash(pnpm:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(xcodebuildmcp:*)",
      "Bash(xcodebuild:*)",
      "Bash(sed:*)",
      "Bash(swift build:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "sonnet"
}
